---
import type { Place } from '../data/places';
import { drivingUrl } from '../lib/event';
interface Props { place: Place }
const { place } = Astro.props;
---

<li class="place-card">
  <h4>{place.name}</h4>
  <p>{place.description}</p>
  <p class="place-address">{place.address}</p>
  <p><strong>営業時間</strong><br />{place.hours}</p>
  <p class="place-distance">{place.roadKm !== null && place.carMinutes !== null
    ? `畑から道路で約${place.roadKm}km・車で約${place.carMinutes}分`
    : '距離・所要時間は地図で確認'}</p>
  <div class="place-links">
    <a class="button secondary" href={drivingUrl(place)} aria-label={`${place.name}への車の経路`}>車の経路を見る <span aria-hidden="true">↗</span></a>
    <a class="text-link" href={place.officialUrl} aria-label={`${place.name}の公式情報`}>お店の公式情報 <span aria-hidden="true">↗</span></a>
  </div>
  <p class="place-checked">公式情報の確認日：<time datetime={place.checkedAt}>{place.checkedAt}</time></p>
</li>

<style>
  .place-card { min-width: 0; padding: 1.3rem 1rem; border: 1px solid var(--border); border-radius: 10px; background: #fffdf8; }
  h4 { font-size: 1.12rem; line-height: 1.65; margin: 0 0 .8rem; }
  .place-address, .place-distance, .place-checked { color: var(--muted); }
  .place-links { display: grid; margin-top: 1.2rem; text-align: center; }
  .place-checked { margin-top: .5rem; }
</style>
